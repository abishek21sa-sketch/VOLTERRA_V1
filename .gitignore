# Data (large, regenerable from ingestion — never commit)
data/raw/**
data/snapshots/**
!data/raw/.gitkeep
!data/snapshots/.gitkeep
warehouse/*.duckdb
warehouse/*.duckdb.wal
# volterra.duckdb is the exception: at ~18MB (well under GitHub's 100MB limit) it's small enough
# to commit directly rather than needing AUTOMOTIVE_PRODUCT_V1's GitHub-Release-asset pattern
# (that project's warehouse is 644MB). Rebuild and re-commit it after refreshing any snapshot --
# see warehouse/build_warehouse.py.
!warehouse/volterra.duckdb

# ml/ generated training data and trained model artifacts — regenerable via
# simulation/examples/generate_queue_risk_dataset.jl + ml/examples/train_queue_risk_model.py
ml/data/**
!ml/data/.gitkeep
# queue_risk_predictions.json is the exception: it's the only ml/ artifact backend/ actually
# reads at runtime (see internal/mlpredictions), it's small (tens of KB, 17 real sites), and
# Render's Go build step doesn't persist generated files into the runtime container -- same
# reasoning as warehouse/volterra.duckdb above. Regenerate via
# ml/examples/predict_real_sites_grid.py after refreshing the warehouse or retraining models.
!ml/data/queue_risk_predictions.json

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Julia
optimization/Manifest.toml
simulation/Manifest.toml
graph/Manifest.toml
routing/Manifest.toml
*.jl.cov
*.jl.mem

# Node / Angular
frontend/node_modules/
frontend/.angular/
frontend/dist/
npm-debug.log*

# Go
backend/bin/
backend/*.exe

# Env / secrets
.env
.env.local
*.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
